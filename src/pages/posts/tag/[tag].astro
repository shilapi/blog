---
import PostArchive from "../../../components/PostArchive.astro";
import type { Post } from "../../../data/posts";
import { getPostTagStaticPaths } from "../../../lib/post-routes";

export async function getStaticPaths() {
  return getPostTagStaticPaths();
}

const { tag } = Astro.params;

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<PostArchive
  title={`标签：${tag ?? ""}`}
  heading={tag ?? "tags"}
  backHref="/posts/"
  posts={posts}
/>
