---
import PostArchive from "../../components/PostArchive.astro";
import { getPostsByType } from "../../lib/post-routes";

const posts = await getPostsByType("Post");
---

<PostArchive
  title="Posts"
  heading="posts"
  backHref="/"
  posts={posts}
  description="All posts."
  ogImage="/og/posts.png"
  emptyMessage="暂无可公开显示的 Post。"
/>
