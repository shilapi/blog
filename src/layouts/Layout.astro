---
import InteractiveTiles from "../components/InteractiveTiles.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteSidebar from "../components/SiteSidebar.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  showSidebar?: boolean;
  wideContent?: boolean;
  narrowContent?: boolean;
  fillViewport?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
}

const {
  title = siteConfig.siteName,
  description = siteConfig.description,
  showSidebar = true,
  wideContent = false,
  narrowContent = false,
  fillViewport = false,
  ogImage = "/og/site.png",
  ogType = "website",
} = Astro.props;
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? siteConfig.siteUrl,
);
const ogImageUrl = new URL(ogImage, Astro.site ?? siteConfig.siteUrl);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-rounded-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-rounded-16x16.png"
    />
    <link rel="shortcut icon" href="/favicon.ico?v=rounded" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.brandName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${title} — ${siteConfig.brandName}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
  </head>

  <body
    class:list={{
      "has-sidebar": showSidebar,
      "has-wide-content": wideContent,
      "has-narrow-content": narrowContent,
      "fills-viewport": fillViewport,
    }}
  >
    {showSidebar && <SiteSidebar />}

    <main class="site-main container">
      <slot />
    </main>

    <SiteFooter />
    <InteractiveTiles />
  </body>
</html>
