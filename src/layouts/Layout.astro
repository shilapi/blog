---
import InteractiveTiles from "../components/InteractiveTiles.astro";
import { siteConfig } from "../config";

interface Props {
  title?: string;
  description?: string;
  showSidebar?: boolean;
  wideContent?: boolean;
}

const {
  title = siteConfig.siteName,
  description = siteConfig.description,
  showSidebar = true,
  wideContent = false,
} = Astro.props;

const navigation = [
  { href: "/", label: "~", current: Astro.url.pathname === "/" },
  {
    href: "/posts/",
    label: "~/Posts",
    current: Astro.url.pathname.startsWith("/posts"),
  },
  {
    href: "/about/",
    label: "~/AboutMe",
    current: Astro.url.pathname === "/about/",
  },
];

const footerRedirect = [
  {
    href: "/PrivacyPage",
    label: "privacy",
    current: Astro.url.pathname === "/",
  },
];
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    {description && <meta name="description" content={description} />}
  </head>

  <body
    class:list={{
      "has-sidebar": showSidebar,
      "has-wide-content": wideContent,
    }}
  >
    {
      showSidebar && (
        <header class="site-header">
          <div class="sidebar-content">
            <a class="brand" href="/">
              <span>{siteConfig.brandName}</span>
            </a>

            <nav class="sidebar-navigation" aria-label="navigator">
              {navigation.map(({ href, label, current }) => (
                <a
                  href={href}
                  class:list={{ "is-current": current }}
                  aria-current={current ? "page" : undefined}
                >
                  <span class="nav-label">
                    <span class="nav-prompt" aria-hidden="true">
                      &gt;
                    </span>
                    {label}
                  </span>
                </a>
              ))}
            </nav>
          </div>
        </header>
      )
    }

    <main class="site-main container">
      <slot />
    </main>

    <footer class="site-footer container">
      <span>© 2026 Shilapi</span>
      <nav class="footer-navigation" aria-label="footer navigator">
        {
          footerRedirect.map(({ href, label, current }) => (
            <a
              href={href}
              class:list={{ "is-current": current }}
              aria-current={current ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </footer>
    <InteractiveTiles />
  </body>
</html>

<style>
  :global(:root) {
    /* Black-violet palette */
    --background: #09070f;
    --surface: #09070f;
    --surface-raised: #09070f;
    --surface-hover: #211a36;
    --foreground: #f0ebff;
    --muted: #aaa0c1;
    --subtle: #746987;
    --border: #302744;
    --border-strong: #4a3a68;
    --accent: #bb86fc;
    --accent-strong: #d1a7ff;
    --accent-soft: #7c3aed;
    /* "Shilapi's blog" is 14 mono characters; reserve 1.2 times its width. */
    --sidebar-min-content-width: 16.8ch;
    --sidebar-padding-inline: 2.5rem;
    --sidebar-width: max(
      12%,
      calc(var(--sidebar-min-content-width) + var(--sidebar-padding-inline))
    );
    /* 2.5ch prompt space + 9ch for the longest item, "~/AboutMe". */
    --nav-prompt-width: 2.5ch;
    --nav-label-width: 9ch;
    --font-mono:
      "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  :global(html) {
    color-scheme: dark;
    background: var(--background);
    scroll-behavior: smooth;
  }

  body {
    --content-max-width: 920px;
    margin: 0;
    min-height: 100vh;
    color: var(--foreground);
    background: var(--background);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  body.has-wide-content {
    --content-max-width: 1040px;
  }

  .container {
    width: min(100% - 64px, var(--content-max-width));
    margin: 0 auto;
  }

  .site-header {
    position: fixed;
    z-index: 10;
    inset: 0 auto 0 0;
    width: var(--sidebar-width);
    border-right: 1px solid var(--border);
    background: var(--surface);
    backdrop-filter: blur(18px);
  }

  .sidebar-content {
    display: flex;
    height: 100%;
    box-sizing: border-box;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem 2rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .brand [aria-hidden="true"],
  .sidebar-tail {
    color: var(--border-strong);
    font-weight: 400;
  }

  .sidebar-navigation {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.5em;
    margin-top: 3.5rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .sidebar-navigation a {
    display: block;
    color: var(--muted);
    padding: 0.2rem 0;
    text-decoration: none;
  }

  .nav-label {
    position: relative;
    display: inline-block;
    width: var(--nav-label-width);
  }

  .nav-prompt {
    position: absolute;
    left: calc(-1 * var(--nav-prompt-width));
    width: var(--nav-prompt-width);
    color: var(--accent-strong);
    visibility: hidden;
  }

  .sidebar-navigation a:hover,
  .sidebar-navigation a:focus-visible,
  .sidebar-navigation a.is-current {
    color: var(--accent-strong);
    outline: none;
  }

  .sidebar-tail {
    max-width: 100%;
    margin-top: auto;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    white-space: nowrap;
  }

  .sidebar-navigation a:hover .nav-prompt,
  .sidebar-navigation a:focus-visible .nav-prompt,
  .sidebar-navigation a.is-current .nav-prompt {
    visibility: visible;
  }

  .sidebar-navigation:has(a:not(.is-current):is(:hover, :focus-visible))
    a.is-current {
    color: var(--muted);
  }

  .sidebar-navigation:has(a:not(.is-current):is(:hover, :focus-visible))
    a.is-current
    .nav-prompt {
    visibility: hidden;
  }

  .has-sidebar .site-main,
  .has-sidebar .site-footer {
    width: min(
      calc(100vw - var(--sidebar-width) - 4rem),
      var(--content-max-width)
    );
    margin-left: calc(
      var(--sidebar-width) +
        max(2rem, (100vw - var(--sidebar-width) - var(--content-max-width)) / 2)
    );
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.5rem 2.5rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }

  .site-footer > span,
  .footer-navigation {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .footer-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: flex-end;
    margin-left: auto;
  }

  .footer-navigation a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-navigation a:hover,
  .footer-navigation a:focus-visible,
  .footer-navigation a.is-current {
    color: var(--accent-strong);
    outline: none;
  }

  :global(::selection) {
    color: var(--foreground);
    background: var(--accent-soft);
  }

  @media (max-width: 760px) {
    .site-header {
      position: static;
      width: auto;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .sidebar-content {
      height: auto;
      padding: 1rem 1.25rem;
    }

    .sidebar-tail {
      display: none;
    }

    .sidebar-navigation {
      flex-direction: row;
      gap: 0.5em;
      margin-top: 1.25rem;
      overflow-x: auto;
    }

    .sidebar-navigation a {
      padding: 0.45rem 0.55rem;
      white-space: nowrap;
    }

    .container {
      width: min(100% - 40px, 920px);
    }

    .has-sidebar .site-main,
    .has-sidebar .site-footer {
      width: min(100% - 40px, var(--content-max-width));
      margin-left: auto;
    }
  }
</style>
