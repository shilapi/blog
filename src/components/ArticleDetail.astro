---
import type { Post } from "../data/posts";
import { siteConfig } from "../config";
import { getPageBlocks } from "../lib/notion";
import { notionHeadingEntries } from "../lib/notion-render";
import { ogImageKey } from "../lib/og";
import Layout from "../layouts/Layout.astro";
import ArticleToc from "./ArticleToc.astro";
import NotionBlocks from "./NotionBlocks.astro";
import PageHeading from "./PageHeading.astro";
import PostTags from "./PostTags.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const blocks = post.sourceId ? await getPageBlocks(post.sourceId) : [];
const tocEntries = notionHeadingEntries(blocks);
---

<Layout
  title={post.title}
  description={post.excerpt || siteConfig.description}
  ogImage={`/og/${ogImageKey(post)}.png`}
  ogType="article"
  wideContent
  narrowContent
>
  <article class="post-detail">
    <PageHeading
      title={post.title}
      backHref={post.type === "Post" ? "/posts/" : "/"}
      inset={false}
    />

    <div class="post-meta">
      <p class="post-date">
        <time datetime={post.date}>{post.date}</time>
      </p>
      <PostTags tags={post.tags} />
    </div>

    {
      post.featuredImage && (
        <div class="featured-image-wrap">
          <img
            class="featured-image"
            src={post.featuredImage}
            alt={`文章配图：${post.title}`}
          />
        </div>
      )
    }

    {
      blocks.length > 0 ? (
        <div class="content notion-content">
          <NotionBlocks blocks={blocks} />
        </div>
      ) : (
        <div class="content">{post.content}</div>
      )
    }
  </article>
  <ArticleToc entries={tocEntries} />
</Layout>

<style>
  .post-detail {
    width: 100%;
    padding-block: 56px 80px;
    font-family: "Pretendard", var(--font-sans);
  }

  .post-meta {
    margin-bottom: 1.75rem;
  }

  .post-date {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .featured-image-wrap {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin-bottom: 1.75rem;
    padding-bottom: 66%;
    border-radius: 1.5rem;
    background: var(--surface-hover);
  }

  .featured-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    margin: 0;
    color: var(--foreground);
    font-size: 1rem;
    line-height: 1.5;
    white-space: normal;
  }

  @media (min-width: 1024px) {
    .featured-image-wrap {
      padding-bottom: 50%;
    }
  }
</style>
