---
import type { Post } from "../data/posts";
import { getPageBlocks } from "../lib/notion";
import BackLink from "./BackLink.astro";
import Layout from "../layouts/Layout.astro";
import NotionBlocks from "./NotionBlocks.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const blocks = post.sourceId ? await getPageBlocks(post.sourceId) : [];
---

<Layout title={post.title} description={post.excerpt}>
  <article class="post-detail">
    <BackLink href={post.type === "Post" ? "/posts/" : "/"} />

    <header class="post-header">
      <p class="post-date">
        <time datetime={post.date}>{post.date}</time>
      </p>

      <h1>{post.title}</h1>

      <div class="tags">
        {
          post.tags.map((tag) => (
            <span>
              <span aria-hidden="true">[</span>
              {tag}
              <span aria-hidden="true">]</span>
            </span>
          ))
        }
      </div>
    </header>

    {
      post.featuredImage && (
        <img
          class="featured-image"
          src={post.featuredImage}
          alt={`文章配图：${post.title}`}
        />
      )
    }

    {
      blocks.length > 0 ? (
        <div class="content notion-content">
          <NotionBlocks blocks={blocks} />
        </div>
      ) : (
        <div class="content">{post.content}</div>
      )
    }

    <div class="file-ending" aria-hidden="true">eof</div>
  </article>
</Layout>

<style>
  .post-detail {
    width: 100%;
    padding-block: 56px 80px;
  }

  .post-date {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .post-header {
    padding: 2.5rem 0 2rem;
  }

  h1 {
    margin: 0.8rem 0 1.5rem;
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  .tags {
    display: flex;
    gap: 8px;
  }

  .featured-image {
    display: block;
    width: 100%;
    max-height: 32rem;
    margin: 0 0 2rem;
    object-fit: cover;
  }

  .tags span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .content {
    margin-top: 2.5rem;
    color: var(--foreground);
    font-size: 1.15rem;
    line-height: 2;
    white-space: pre-wrap;
  }

  .file-ending {
    margin-top: 3rem;
    color: var(--border-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .post-header {
      padding: 2rem 0 1.5rem;
    }
  }
</style>
