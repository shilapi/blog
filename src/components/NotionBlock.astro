---
import NotionCodeBlock from "./NotionCodeBlock.astro";
import NotionBookmark from "./NotionBookmark.astro";
import NotionRichText from "./NotionRichText.astro";
import { textFromRichText, type NotionBlock as Block } from "../lib/notion";
import {
  linkFromNotionData,
  notionCellRichText,
  notionHeadingId,
  notionIconText,
  youTubeEmbedUrl,
} from "../lib/notion-render";

interface Props {
  block: Block;
  headings?: Block[];
}

const { block, headings = [] } = Astro.props;
const data = block.data;
const richText = data.rich_text;
const text = textFromRichText(richText);
const caption = data.caption;
---

{
  (() => {
    switch (block.type) {
      case "paragraph":
        return (
          <>
            <p class:list={{ "notion-blank": text.length === 0 }}>
              <NotionRichText richText={richText} />
            </p>
            {block.children?.map((child) => (
              <Astro.self block={child} />
            ))}
          </>
        );

      case "heading_1":
        return (
          <>
            <h2 id={notionHeadingId(text, block.id)}>
              <NotionRichText richText={richText} />
            </h2>
            {block.children?.map((child) => (
              <Astro.self block={child} />
            ))}
          </>
        );

      case "heading_2":
        return (
          <>
            <h3 id={notionHeadingId(text, block.id)}>
              <NotionRichText richText={richText} />
            </h3>
            {block.children?.map((child) => (
              <Astro.self block={child} />
            ))}
          </>
        );

      case "heading_3":
        return (
          <>
            <h4 id={notionHeadingId(text, block.id)}>
              <NotionRichText richText={richText} />
            </h4>
            {block.children?.map((child) => (
              <Astro.self block={child} />
            ))}
          </>
        );

      case "quote":
        return (
          <>
            <blockquote>
              <NotionRichText richText={richText} />
            </blockquote>
            {block.children?.map((child) => (
              <Astro.self block={child} />
            ))}
          </>
        );

      case "callout":
        return (
          <aside class="notion-callout">
            <span class="notion-callout-icon">{notionIconText(data.icon)}</span>
            <div class="notion-callout-body">
              <NotionRichText richText={richText} />
              {block.children?.map((child) => (
                <Astro.self block={child} />
              ))}
            </div>
          </aside>
        );

      case "code":
        return (
          <NotionCodeBlock
            text={text}
            language={
              typeof data.language === "string" ? data.language : undefined
            }
          />
        );

      case "image":
        return block.assetUrl ? (
          <figure class="notion-image">
            <img
              src={block.assetUrl}
              alt={textFromRichText(caption) || "Notion image"}
              loading="lazy"
            />
            {Array.isArray(caption) && caption.length > 0 && (
              <figcaption>
                <NotionRichText richText={caption} />
              </figcaption>
            )}
          </figure>
        ) : null;

      case "video": {
        const url = block.assetUrl || linkFromNotionData(data.external);
        const youTubeUrl = url ? youTubeEmbedUrl(url) : undefined;
        return youTubeUrl ? (
          <iframe
            class="notion-video"
            src={youTubeUrl}
            title={textFromRichText(caption) || "Embedded video"}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        ) : url ? (
          <video class="notion-video" controls src={url} />
        ) : null;
      }

      case "file":
        return block.assetUrl ? (
          <p class="notion-file">
            <a href={block.assetUrl} download>
              {text || "下载文件"}
            </a>
          </p>
        ) : null;

      case "divider":
        return <hr />;

      case "bulleted_list":
        return (
          <ul>
            {block.children?.map((item) => (
              <li>
                <Astro.self block={item} />
              </li>
            ))}
          </ul>
        );

      case "numbered_list":
        return (
          <ol>
            {block.children?.map((item) => (
              <li>
                <Astro.self block={item} />
              </li>
            ))}
          </ol>
        );

      case "to_do_list":
        return (
          <ul class="notion-todo-list">
            {block.children?.map((item) => {
              const checked = item.data.checked === true;
              return (
                <li class:list={{ "is-done": checked }}>
                  <input type="checkbox" checked={checked} disabled />
                  <Astro.self block={item} />
                </li>
              );
            })}
          </ul>
        );

      case "bulleted_list_item":
      case "numbered_list_item":
      case "to_do":
        return (
          <>
            <NotionRichText richText={richText} />
            {block.children?.map((child) => (
              <Astro.self block={child} />
            ))}
          </>
        );

      case "toggle":
        return (
          <details>
            <summary>
              <NotionRichText richText={richText} />
            </summary>
            {block.children?.map((child) => (
              <Astro.self block={child} />
            ))}
          </details>
        );

      case "table":
        return (
          <div class="notion-table-wrap">
            <table>
              <tbody>
                {block.children?.map((row, rowIndex) => {
                  const cells = Array.isArray(row.data.cells)
                    ? row.data.cells
                    : [];
                  return (
                    <tr>
                      {cells.map((cell, columnIndex) => {
                        const isHeader =
                          (data.has_column_header === true && rowIndex === 0) ||
                          (data.has_row_header === true && columnIndex === 0);
                        const Cell = isHeader ? "th" : "td";
                        return (
                          <Cell>
                            <NotionRichText
                              richText={notionCellRichText(cell)}
                            />
                          </Cell>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        );

      case "column_list":
        return (
          <div class="notion-columns">
            {block.children?.map((column) => (
              <div class="notion-column">
                {column.children?.map((child) => (
                  <Astro.self block={child} />
                ))}
              </div>
            ))}
          </div>
        );

      case "bookmark":
      case "link_preview":
        return linkFromNotionData(data.url) && block.bookmarkPreview ? (
          <NotionBookmark
            url={linkFromNotionData(data.url)}
            preview={block.bookmarkPreview}
          />
        ) : null;

      case "embed":
        return linkFromNotionData(data.url) ? (
          <p class="notion-link">
            <a
              href={linkFromNotionData(data.url)}
              target="_blank"
              rel="noreferrer"
            >
              {linkFromNotionData(data.url)}
            </a>
          </p>
        ) : null;

      case "equation":
        return (
          <code class="notion-equation">
            {typeof data.expression === "string" ? data.expression : ""}
          </code>
        );

      case "table_of_contents":
        return (
          <nav class="notion-table-of-contents" aria-label="文章目录">
            {headings.map((heading) => {
              const headingText = textFromRichText(heading.data.rich_text);
              const level = heading.type.replace("heading_", "");
              return (
                <a
                  class={`level-${level}`}
                  href={`#${notionHeadingId(headingText, heading.id)}`}
                >
                  {headingText}
                </a>
              );
            })}
          </nav>
        );

      case "link_to_page":
        return (
          <p class="notion-link">
            Notion page: {typeof data.page_id === "string" ? data.page_id : ""}
          </p>
        );

      default:
        return null;
    }
  })()
}
