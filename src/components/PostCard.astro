---
import type { Post } from "../data/posts";
import { postHref } from "../lib/post-routes";
import PostTags from "./PostTags.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, excerpt, date, tags, featuredImage } = post;
---

<div class="post-card-hitbox" data-interactive-tile-hitbox>
  <a
    class="post-card-hit-target"
    href={postHref(post)}
    aria-label={`阅读文章：${title}`}></a>

  <article class="post-card" data-interactive-tile>
    <span class="row-marker" aria-hidden="true">&gt;</span>

    <div class="post-body">
      <h3>{title}</h3>
      {excerpt && <p class="excerpt">{excerpt}</p>}

      <PostTags tags={tags} />

      <p class="post-date">
        <time datetime={date}>{date}</time>
      </p>
    </div>

    {
      featuredImage && (
        <div class="featured-image">
          <img src={featuredImage} alt={`文章配图：${title}`} loading="lazy" />
        </div>
      )
    }
  </article>
</div>

<style>
  .post-card {
    --post-card-padding: 1.25rem;
    --post-card-image-width: 12.75rem;
    z-index: 2;
    display: grid;
    grid-template-columns:
      0.625rem minmax(0, 1fr)
      var(--post-card-image-width);
    gap: 1rem;
    align-items: stretch;
    min-height: 11rem;
    padding: var(--post-card-padding);
    pointer-events: none;
  }

  .post-card-hit-target {
    position: absolute;
    z-index: 1;
    inset: 0;
    outline: none;
  }

  .row-marker {
    display: grid;
    height: 1.8125rem;
    place-items: center;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    line-height: 1;
    opacity: 0;
    pointer-events: none;
  }

  .post-card-hitbox[data-tile-pointer-active] .row-marker,
  .post-card-hitbox:focus-within .row-marker {
    opacity: 1;
  }

  .post-date {
    margin: 1rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    pointer-events: none;
    white-space: nowrap;
  }

  .post-body {
    position: static;
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  h3 {
    margin: 0;
    color: var(--foreground);
    font-size: 1.25rem;
    line-height: 1.45;
    transition: color 140ms ease;
  }

  .post-card-hitbox[data-tile-pointer-active] h3,
  .post-card-hitbox:focus-within h3 {
    color: var(--accent);
  }

  .featured-image {
    position: absolute;
    top: var(--post-card-padding);
    right: var(--post-card-padding);
    bottom: var(--post-card-padding);
    display: block;
    width: var(--post-card-image-width);
    pointer-events: none;
  }

  .featured-image img {
    display: block;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    object-fit: cover;
  }

  .excerpt {
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .post-card {
      --post-card-padding: 1rem;
      --post-card-image-width: clamp(4.5rem, 28vw, 12.75rem);
      grid-template-columns:
        1ch minmax(0, 1fr)
        var(--post-card-image-width);
      gap: 0.8rem;
    }

    .post-body {
      grid-column: 2;
    }

    .featured-image {
      width: var(--post-card-image-width);
    }
  }
</style>
