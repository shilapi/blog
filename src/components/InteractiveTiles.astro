<script>
  const finePointer = window.matchMedia("(pointer: fine)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (finePointer.matches) {
    document
      .querySelectorAll<HTMLElement>("[data-interactive-tile-hitbox]")
      .forEach((hitbox) => {
        const tile = hitbox.querySelector<HTMLElement>(
          ":scope > [data-interactive-tile]",
        );
        if (!tile) return;

        let frame = 0;

        const reset = () => {
          cancelAnimationFrame(frame);
          hitbox.removeAttribute("data-tile-pointer-active");
          tile.style.removeProperty("--tile-rotate-x");
          tile.style.removeProperty("--tile-rotate-y");
          tile.style.removeProperty("--pointer-x");
          tile.style.removeProperty("--pointer-y");
        };

        const update = (event: PointerEvent) => {
          const bounds = hitbox.getBoundingClientRect();
          const x = (event.clientX - bounds.left) / bounds.width;
          const y = (event.clientY - bounds.top) / bounds.height;
          const isInside = x >= 0 && x <= 1 && y >= 0 && y <= 1;

          if (!isInside) {
            reset();
            return;
          }

          hitbox.setAttribute("data-tile-pointer-active", "");
          if (reducedMotion.matches) return;

          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            tile.style.setProperty("--tile-rotate-x", `${(0.5 - y) * 4}deg`);
            tile.style.setProperty("--tile-rotate-y", `${(x - 0.5) * 4}deg`);
            tile.style.setProperty("--pointer-x", `${x * 100}%`);
            tile.style.setProperty("--pointer-y", `${y * 100}%`);
          });
        };

        hitbox.addEventListener("pointerenter", update);
        hitbox.addEventListener("pointermove", update);
        hitbox.addEventListener("pointerleave", reset);
      });
  }
</script>

<style>
  :global([data-interactive-tile-hitbox]) {
    position: relative;
    min-width: 0;
  }

  :global([data-interactive-tile-hitbox] > [data-interactive-tile]) {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  :global([data-interactive-tile]) {
    --tile-rotate-x: 0deg;
    --tile-rotate-y: 0deg;
    --pointer-x: 50%;
    --pointer-y: 50%;
    position: relative;
    background: transparent;
    transform: perspective(640px) translateY(0) rotateX(0) rotateY(0) scale(1);
    transform-style: preserve-3d;
    transition:
      color 140ms ease,
      background-color 140ms ease,
      box-shadow 160ms ease,
      transform 120ms ease-out;
    will-change: transform;
  }

  :global([data-interactive-tile]::before) {
    position: absolute;
    z-index: 0;
    inset: 0;
    content: "";
    background: radial-gradient(
      circle at var(--pointer-x) var(--pointer-y),
      rgb(187 134 252 / 0.06),
      transparent 80%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 140ms ease;
  }

  :global([data-interactive-tile]::after) {
    position: absolute;
    right: 1px;
    bottom: 1px;
    width: 1em;
    height: 1em;
    box-sizing: border-box;
    content: "";
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    opacity: 1;
    pointer-events: none;
    transition: opacity 80ms ease;
  }

  :global(
    [data-interactive-tile-hitbox]:is([data-tile-pointer-active], :focus-within)
      > [data-interactive-tile]
  ) {
    color: var(--accent-strong);
    background: var(--surface-hover);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.32);
    outline: none;
    transform: perspective(640px) translateY(-2px) rotateX(var(--tile-rotate-x))
      rotateY(var(--tile-rotate-y)) scale(0.995);
  }

  :global(
    [data-interactive-tile-hitbox]:is([data-tile-pointer-active], :focus-within)
      > [data-interactive-tile]::before
  ) {
    opacity: 1;
  }

  :global(
    [data-interactive-tile-hitbox]:is([data-tile-pointer-active], :focus-within)
      > [data-interactive-tile]::after
  ) {
    opacity: 0;
  }

  :global([data-interactive-tile-hitbox]:active > [data-interactive-tile]) {
    box-shadow: 0 5px 14px rgb(0 0 0 / 0.24);
    transform: perspective(640px) translateY(0) rotateX(var(--tile-rotate-x))
      rotateY(var(--tile-rotate-y)) scale(0.985);
  }

  :global([data-interactive-tile] > *) {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-interactive-tile]) {
      transform: none;
      transition:
        color 140ms ease,
        background-color 140ms ease,
        box-shadow 140ms ease;
    }

    :global([data-interactive-tile-hitbox] > [data-interactive-tile]) {
      transform: none;
    }
  }
</style>
