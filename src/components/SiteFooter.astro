---
const links = [{ href: "/PrivacyPage", label: "privacy" }];
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<footer class="site-footer container">
  <span>© 2026 Shilapi</span>
  <nav class="footer-navigation" aria-label="footer navigator">
    {
      links.map(({ href, label }) => {
        const current = normalizedPath === href;
        return (
          <a
            href={href}
            class:list={{ "is-current": current }}
            aria-current={current ? "page" : undefined}
          >
            {label}
          </a>
        );
      })
    }
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 1.5rem 2.5rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }

  .site-footer > span,
  .footer-navigation {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .footer-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: flex-end;
    margin-left: auto;
  }

  .footer-navigation a {
    color: var(--muted);
    text-decoration: none;
  }

  .footer-navigation a:hover,
  .footer-navigation a:focus-visible,
  .footer-navigation a.is-current {
    color: var(--accent-strong);
    outline: none;
  }
</style>
