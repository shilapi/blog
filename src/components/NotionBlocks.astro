---
import NotionBlock from "./NotionBlock.astro";
import type { NotionBlock as Block } from "../lib/notion";
import { groupNotionListsDeep, notionHeadings } from "../lib/notion-render";
import "../styles/notion-blocks.css";

interface Props {
  blocks: Block[];
}

const groupedBlocks = groupNotionListsDeep(Astro.props.blocks);
const headings = notionHeadings(Astro.props.blocks);
---

<div class="notion-blocks">
  {
    groupedBlocks.map((block) => (
      <NotionBlock block={block} headings={headings} />
    ))
  }
</div>

<style>
  .notion-blocks {
    display: flex;
    width: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.5;
  }
</style>
