---
import NotionBlock from "./NotionBlock.astro";
import type { NotionBlock as Block } from "../lib/notion";
import { groupNotionLists, notionHeadings } from "../lib/notion-render";
import "../styles/notion-blocks.css";

interface Props {
  blocks: Block[];
}

const groupedBlocks = groupNotionLists(Astro.props.blocks);
const headings = notionHeadings(Astro.props.blocks);
---

<div class="notion-blocks">
  {
    groupedBlocks.map((block) => (
      <NotionBlock block={block} headings={headings} />
    ))
  }
</div>

<style>
  .notion-blocks {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
</style>
