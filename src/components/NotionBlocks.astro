---
import NotionBlock from "./NotionBlock.astro";
import type { NotionBlock as Block } from "../lib/notion";

interface Props {
  blocks: Block[];
}

function groupLists(blocks: Block[]): Block[] {
  const grouped: Block[] = [];

  for (const block of blocks) {
    const listType =
      block.type === "bulleted_list_item"
        ? "bulleted_list"
        : block.type === "numbered_list_item"
          ? "numbered_list"
          : block.type === "to_do"
            ? "to_do_list"
            : null;

    if (!listType) {
      grouped.push(block);
      continue;
    }

    const previous = grouped.at(-1);
    if (previous?.type === listType) {
      previous.children ??= [];
      previous.children.push(block);
    } else {
      grouped.push({
        id: `${block.id}-list`,
        type: listType,
        hasChildren: true,
        data: {},
        children: [block],
      });
    }
  }

  return grouped;
}

const groupedBlocks = groupLists(Astro.props.blocks);
const headings = Astro.props.blocks.filter((block) =>
  ["heading_1", "heading_2", "heading_3"].includes(block.type),
);
---

<div class="notion-blocks">
  {
    groupedBlocks.map((block) => (
      <NotionBlock block={block} headings={headings} />
    ))
  }
</div>

<style>
  .notion-blocks {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }
</style>
